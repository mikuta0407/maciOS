# Homebrew settings for maciOS guests.
# Ruby code run in a forked child would share the parent's memory, so
# Homebrew starts commands with spawn instead of fork.
HOMEBREW_SPAWN_SYSTEM=1
# Homebrew is installed from a release tarball, not a git checkout, and
# there is no git: `brew update` cannot work. Formulae come from the API.
HOMEBREW_NO_AUTO_UPDATE=1
